  .pc-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .pc-head b { font-size: 17px; }
  .pc-head .code { color: var(--muted); font-size: 12px; }
  .pc-head .sector { font-size: 11px; color: var(--accent); border: 1px solid var(--accent); border-radius: 999px; padding: 1px 8px; margin-left: 6px; }
  .tag { font-size: 12px; padding: 3px 10px; border-radius: 999px; white-space: nowrap; }
  .tag.good { background: rgba(47,158,68,0.15); color: #2f9e44; }
  .tag.bad { background: rgba(224,49,49,0.12); color: #e03131; }
  .pc-price { font-size: 14px; color: var(--fg); margin: 8px 0 6px; }
  .pc-price .up { color: #e03131; } .pc-price .down { color: #2f9e44; }
