---
import SiteHeader from '../../components/SiteHeader.astro';
const base = import.meta.env.BASE_URL;

const course = {
  name: 'Fund Strategy · Four-Step DCA',
  en: '基金策略',
  desc: 'A practical DCA system across sector, active, bond and index funds.',
  chapters: [
    { slug: 'ch1-intro', title: 'Intro: why a system beats guessing', desc: 'Adopt "respond, do not predict".', free: true },
    { slug: 'ch2-four-step', title: 'Four-step DCA: sector / active / bond / index', desc: 'Roles and sizing of four fund types.', free: true },
    { slug: 'ch3-pick-fund', title: 'How to pick a fund: fees, tracking error, benchmark', desc: 'Low fees compound in your favor.', free: true },
    { slug: 'ch4-position', title: 'Sector-fund strategy for a choppy market', desc: 'In a sideways market, follow the trend and fade the wobble: scale in over 3 tranches, trim by deviation.', free: true },
    { slug: 'ch5-sector', title: 'Sector rotation: ride the up-cycle', desc: 'Entry, exit and taking profit on sector ETFs.', free: false },
    { slug: 'ch6-active', title: 'Active funds: manager, style, drawdown', desc: 'Spot managers who outperform long-term.', free: false },
    { slug: 'ch7-bond', title: 'Bond funds: duration & credit', desc: 'Use bonds to dampen portfolio volatility.', free: false },
    { slug: 'ch10-active-bull', title: 'Active funds in a bull market', desc: "Don't chase rallies: buy in one shot when YTD is below 50% of the average and monthly is below the bull average; then scale out in batches.", free: false },
    { slug: 'ch8-index', title: 'Active funds in a ranging market', desc: 'Buy drawdowns, not rallies; sell half at the 50% annualised line and swing a half position.', free: false },
    { slug: 'ch9-active-bear', title: 'Active funds in a bear market', desc: 'Staggered DCA only when time and space align; swing a half position to lower cost.', free: false },
    { slug: 'ch10-highdiv', title: 'High-Dividend Basics: SOEs / Banks / Utilities', desc: 'What yield is, why these three, buy when richer, sell when compressed, pair with DCA & grid.', free: true },
    { slug: 'ch11-etf-basics', title: 'ETF & Index Fund Basics', desc: 'Index fund vs ETF, four families, how to pick (fees / error / scale / liquidity).', free: false },
    { slug: 'ch12-grid-trading', title: 'ETF Grid Trading Basics', desc: 'Compound the small in choppy markets: band & rungs, stop below, clear above, complement DCA.', free: false },
    { slug: 'ch13-gold-macro', title: 'Gold & Fed Macro Basics', desc: 'Real rates price gold; how FOMC & dot plot move gold & equities; how to track macro.', free: false },
    { slug: 'ch14-bond-bull', title: 'Bond funds in a bull market', desc: 'Buy in one shot when below historical monthly average; scale out in thirds.', free: false },
    { slug: 'ch15-bond-shake', title: 'Bond funds in a ranging market', desc: 'Buy on drawdowns, widen the profit tolerance, keep ≥1/2 position.', free: false },
    { slug: 'ch16-cycle-why', title: 'Why we insist on cycle timing', desc: 'Institutions earn fees; we earn upside & dividends — and A-shares range.', free: false },
    { slug: 'ch17-index-fund', title: 'How to pick a quality index fund', desc: 'Two rules: listed 5+ years, repeatedly makes new highs.', free: false },
    { slug: 'ch18-index-shake', title: 'Index funds in a ranging market', desc: 'Buy pullbacks for swing gains; tiered entries by MA, exits by deviation.', free: false },
    { slug: 'ch19-index-bear', title: 'Index funds in a bear market', desc: 'Back to valuation: build below PE 30%, scale out as PE climbs.', free: false },
    { slug: 'ch20-index-bull', title: 'Index funds in a bull market', desc: 'Hold with the trend + trailing stop: build above MA, add on pullbacks that hold, scale out by drawdown from the high.', free: false },
    { slug: 'ch20-undervalued', title: 'Undervalued Stock Screening Basics', desc: 'What "undervalued" means, PE/PB percentile & PEG, three screening conditions, value traps.', free: false },
    { slug: 'ch21-long-short', title: 'Long vs Short Basics', desc: 'Long buys then sells for a rise; short sells then buys for a fall; a 4-step account opening guide; A-share short tools and the ¥500k barrier.', free: false },
    { slug: 'ch22-leading-stocks', title: 'Leading-Stock Basics', desc: 'Why leaders are steadier, three leader types, emotion/chips/narrative triad, dragon-finding rules, pair with DCA & grid.', free: false },
    { slug: 'ch23-10w-finance', title: 'How to Invest ¥100k: the 5-3-2 Rule', desc: 'Protect the first pot: 50% anchor, 30% arbitrage, 20% DCA — with fixed-income landmines and a retail toolkit.', free: false },
    { slug: 'ch24-fund-types', title: 'Buy/sell playbook for 4 fund types: sector / active / bond / index', desc: 'Explains the differences and gives each a buy/sell discipline with concrete numbers.', free: true },
  ],
};

const kb = {
  name: 'Stock Knowledge 101',
  en: '股票知识小课堂',
  desc: '31 rolling lessons: candlesticks, trend, volume-price, MAs, indicators, financials, valuation, dividends, position & risk — one reusable idea a day.',
  chapters: [
    { slug: 'kb01', title: 'What a candle looks like: bullish, bearish, body, shadows', desc: 'Candlesticks · A candle = one time unit (day/week/min) ', free: true },
    { slug: 'kb02', title: 'The market psychology of a single candle', desc: 'Candlesticks · Long white candle with no shadows: relen', free: true },
    { slug: 'kb03', title: 'Bullish/Bearish engulfing & doji', desc: 'Candle patterns · Bullish engulfing: a large green candle ', free: true },
    { slug: 'kb04', title: 'Hammer, hanging man, morning/evening star', desc: 'Candle patterns · Hammer: long lower shadow, small body at', free: true },
    { slug: 'kb05', title: 'How to draw trend lines & use channels', desc: 'Trend · Up trend line: connect successively high', free: true },
    { slug: 'kb06', title: 'How to find support & resistance', desc: 'Trend · Prior highs/lows: dense historical tradi', free: true },
    { slug: 'kb07', title: 'Volume & basic volume-price relationships', desc: 'Volume-Price · Volume = shares traded per unit time, re', free: true },
    { slug: 'kb08', title: 'Volume-price divergence: an early warning', desc: 'Volume-Price · Top divergence: price makes new highs bu', free: true },
    { slug: 'kb09', title: 'MA system: bullish/bearish alignment', desc: 'Moving Averages · MA(N) = average of last N closes, smooth', free: true },
    { slug: 'kb10', title: 'Golden/Death cross & MA in practice', desc: 'Moving Averages · Golden cross: short MA crosses above lon', free: true },
    { slug: 'kb11', title: 'MACD: DIF, DEA, red/green bars', desc: 'Indicators · MACD measures momentum via the gap betwe', free: true },
    { slug: 'kb12', title: 'MACD crosses & divergence', desc: 'Indicators · Golden cross (DIF over DEA, esp. above z', free: true },
    { slug: 'kb13', title: 'DMI trend-direction indicator', desc: 'Indicators · DMI has +DI(up momentum), −DI(down momen', free: true },
    { slug: 'kb14', title: 'Reading the MACD chart', desc: 'Indicators · DIF(fast)=EMA12−EMA26 most sensitive; DE', free: true },
    { slug: 'kb15', title: 'Reading the volume chart', desc: 'Volume-Price · Volume = shares per unit time, participa', free: true },
    { slug: 'kb16', title: 'RSI relative strength', desc: 'Indicators · RSI = average gain/(avg gain+avg loss) o', free: true },
    { slug: 'kb17', title: 'KDJ stochastic', desc: 'Indicators · KDJ has K, D, J lines; more sensitive to', free: true },
    { slug: 'kb18', title: 'BOLL Bollinger Bands', desc: 'Indicators · BOLL = mid rail (20-day MA) ± 2 standard', free: true },
    { slug: 'kb19', title: 'Combining indicators: MACD + volume + MA', desc: 'Indicators · Single indicators fake out; combining ra', free: true },
    { slug: 'kb20', title: 'Three financial statements overview', desc: 'Financials · Income statement: profit over a period (', free: true },
    { slug: 'kb21', title: 'Reading the income statement', desc: 'Financials · Core chain: revenue → COGS → gross margi', free: true },
    { slug: 'kb22', title: 'Reading the balance sheet', desc: 'Financials · Left = assets (where money went): cash, ', free: true },
    { slug: 'kb23', title: 'Reading the cash flow statement', desc: 'Financials · Operating cash flow: main-business cash;', free: true },
    { slug: 'kb24', title: 'ROE and DuPont analysis', desc: 'Financials · ROE = net profit/equity; how much a shar', free: true },
    { slug: 'kb25', title: 'Growth & quality metrics', desc: 'Financials · Revenue/earnings growth: is the company ', free: true },
    { slug: 'kb26', title: 'PE price-earnings ratio', desc: 'Valuation · PE = price/eps; years to recoup at curre', free: true },
    { slug: 'kb27', title: 'PB, PS & cross-sectional valuation', desc: 'Valuation · PB = price/book value; suits asset-heavy', free: true },
    { slug: 'kb28', title: 'PEG and DCF, simply', desc: 'Valuation · PEG = PE / earnings growth (%), PEG<1 of', free: true },
    { slug: 'kb29', title: 'Dividends, yield & buybacks', desc: 'Dividends · Dividend yield = dividend per share / pr', free: true },
    { slug: 'kb30', title: 'Position sizing & staggered buying', desc: "Position · Staggered buying: don't go all-in; split", free: true },
    { slug: 'kb31', title: 'Stop-loss, take-profit & common pitfalls', desc: 'Risk · Stop loss: set in advance where you admi', free: true },
  ],
};

const kbMap = Object.fromEntries(kb.chapters.map((c) => [c.slug, c]));
const kbGroups = [
  { title: '① Technical basics: Chart · Trend · Volume', en: '技术面入门', items: ['kb01','kb02','kb03','kb04','kb05','kb06','kb07','kb08'] },
  { title: '② Indicators: MAs · Momentum · Combos', en: '技术面指标', items: ['kb09','kb10','kb11','kb12','kb13','kb14','kb15','kb16','kb17','kb18','kb19'] },
  { title: '③ Fundamentals: reading the statements', en: '基本面', items: ['kb20','kb21','kb22','kb23','kb24','kb25'] },
  { title: '④ Valuation · Dividends · Position · Risk', en: '估值·风控', items: ['kb26','kb27','kb28','kb29','kb30','kb31'] },
];

const courseMap = Object.fromEntries(course.chapters.map((c) => [c.slug, c]));
const courseGroups = [
  { title: 'A · Mindset & Method', en: '入门与方法论', desc: 'Build a "respond, do not predict" DCA framework and understand why A-shares demand cycle timing.', items: ['ch1-intro','ch2-four-step','ch3-pick-fund','ch16-cycle-why'] },
  { title: 'B · 4 Fund Types × Market Cycle', en: '四类基金·各周期', desc: 'Sector / active / bond / index — each with buy & sell discipline for bull · ranging · bear markets.', items: ['ch4-position','ch5-sector','ch6-active','ch7-bond','ch8-index','ch9-active-bear','ch10-active-bull','ch11-etf-basics','ch17-index-fund','ch18-index-shake','ch19-index-bear','ch20-index-bull','ch14-bond-bull','ch15-bond-shake'] },
  { title: 'C · Specialties & Tools', en: '特色品种与工具', desc: 'High-dividend, ETF grid, gold & macro — extra tools for the kit.', items: ['ch10-highdiv','ch12-grid-trading','ch13-gold-macro'] },
  { title: 'D · Stock Picking', en: '选股实战', desc: 'From undervalued screening and shorting to leading stocks.', items: ['ch20-undervalued','ch21-long-short','ch22-leading-stocks'] },
  { title: 'E · Portfolio', en: '综合配置', desc: 'Assemble everything into one executable personal plan.', items: ['ch23-10w-finance','ch24-fund-types'] },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <title>Market Notes · Fund DCA · Dynamic Stock Picker</title>
    <meta name="description" content="Market Notes: a fund-DCA column + a dynamic stock picker that judges the cycle and suggests position & DCA." />
  </head>
  <body>
    <SiteHeader lang="en" altLang="中文" altHref="/" />
    <main>
      <section class="hero">
        <p class="kicker">✦ Fund DCA · Dynamic Picker · Cycle Timing</p>
        <h1>Market Notes</h1>
        <p class="hero-sub">Turning a complex market into DCA and stock-picking steps you can actually follow.<br />For learning and fun — not investment advice.</p>
        <a class="hero-cta" href={`${base}course`}>📚 The Column</a>
        <a class="hero-cta alt" href={`${base}selector`}>📈 Dynamic Picker</a>
      </section>

      <section class="banner">
        <span>The column has {course.chapters.length} chapters, the</span>
        <span>Knowledge 101 has {kb.chapters.length} lessons:</span>
        <a href={`${base}course`}>first 4 free</a> · <a href={`${base}course`}>rest by tip ☕️</a> · <a href={`${base}selector`}>Dynamic Picker (sub)</a>
      </section>

      <section class="path">
        <h2>🧭 Suggested learning order</h2>
        <ol class="path-steps">
          <li><b>Foundation</b>: read "Stock Knowledge 101" ①→②→③→④ to build basic chart & statement vocabulary.</li>
          <li><b>System</b>: enter "Fund Strategy" modules A→B→C for the four-step DCA and per-cycle playbooks.</li>
          <li><b>Stocks</b>: module D stock picking + module E portfolio — turn the method into your own plan.</li>
          <li><b>Tool</b>: pair with the "Dynamic Picker" to auto-judge cycle & position (subscription).</li>
        </ol>
      </section>

      <section class="series-block">
        <h2>{kb.name} <span class="en">{kb.en}</span></h2>
        <p class="series-desc">{kb.desc}</p>
        {kbGroups.map((g) => (
          <div class="module">
            <h3 class="module-h">{g.title} <span class="en">{g.en}</span></h3>
            <ul class="post-list">
              {g.items.map((slug) => {
                const c = kbMap[slug];
                return (
                  <li>
                    <a href={`${base}blog/${c.slug}`}>
                      <span class="ch-no">{slug.slice(2)}</span>
                      {c.title}
                      <span class="badge free">free</span>
                    </a>
                    <div class="date">{c.desc}</div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </section>

      <section class="series-block">
        <h2>{course.name} <span class="en">{course.en}</span></h2>
        <p class="series-desc">{course.desc}</p>
        {courseGroups.map((g) => (
          <div class="module">
            <h3 class="module-h">{g.title}</h3>
            {g.desc && <p class="module-desc">{g.desc}</p>}
            <ul class="post-list">
              {g.items.map((slug, i) => {
                const c = courseMap[slug];
                return (
                  <li>
                    <a href={`${base}blog/${c.slug}`}>
                      <span class="ch-no">{(i + 1).toString().padStart(2, '0')}</span>
                      {c.title}
                      {c.free
                        ? <span class="badge free">free</span>
                        : <span class="badge paid">☕️ tip</span>}
                    </a>
                    <div class="date">{c.desc}</div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </section>

      <p class="foot-note">⚠️ Everything here is for learning and fun only — not investment, financial or trading advice. Markets are risky; decide carefully.</p>
    </main>
    <footer>© 2026 Market Notes · Hosted on GitHub Pages</footer>

    <style is:global>
      .hero { text-align: center; padding: 56px 16px 28px; }
      .kicker { color: var(--accent); letter-spacing: 2px; font-size: 13px; margin: 0 0 8px; }
      .hero h1 { font-size: 44px; margin: 0 0 12px; letter-spacing: 4px; }
      .hero-sub { color: var(--muted); font-size: 16px; line-height: 1.9; margin: 0 auto 22px; max-width: 560px; }
      .hero-cta { display: inline-block; padding: 12px 28px; border-radius: 999px; background: var(--accent); color: #fff; text-decoration: none; font-size: 16px; transition: transform .15s, opacity .15s; margin: 0 6px; }
      .hero-cta.alt { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
      .hero-cta:hover { transform: translateY(-2px); opacity: .92; }
      .banner { text-align: center; color: var(--muted); font-size: 14px; margin: 12px 0 8px; }
      .banner a { color: var(--accent); text-decoration: none; }
      .path { margin-top: 28px; background: var(--code-bg); border: 1px solid var(--border); border-radius: 12px; padding: 18px 22px; }
      .path h2 { font-size: 20px; margin: 0 0 10px; }
      .path-steps { margin: 0; padding-left: 20px; color: var(--fg); font-size: 14.5px; line-height: 1.95; }
      .path-steps b { color: var(--accent); }
      .series-block { margin-top: 30px; }
      .series-block > h2 { font-size: 22px; border-left: 4px solid var(--accent); padding-left: 10px; }
      .series-block > h2 .en { font-size: 14px; color: var(--muted); font-weight: 400; margin-left: 6px; }
      .series-desc { color: var(--muted); font-size: 14px; margin: 6px 0 14px; }
      .module { margin-top: 18px; }
      .module-h { font-size: 18px; border-left: 3px solid var(--accent); padding-left: 9px; margin: 4px 0 2px; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
      .module-h .en { font-size: 12.5px; color: var(--muted); font-weight: 400; }
      .module-desc { color: var(--muted); font-size: 13.5px; margin: 4px 0 10px; }
      .post-list { list-style: none; padding: 0; }
      .post-list li { padding: 12px 16px; border: 1px solid var(--border); border-radius: 8px; margin-bottom: 9px; transition: border-color .15s; }
      .post-list li:hover { border-color: var(--accent); }
      .post-list a { font-weight: 600; color: var(--fg); text-decoration: none; font-size: 16.5px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
      .post-list .ch-no { color: var(--accent); font-weight: 800; font-size: 13px; }
      .post-list .date { color: var(--muted); font-size: 13px; margin-top: 4px; }
      .badge { display: inline-block; padding: 1px 9px; border-radius: 999px; font-size: 12px; font-weight: 600; }
      .badge.free { background: rgba(21,101,192,0.10); color: var(--accent); }
      .badge.paid { background: rgba(214,48,49,0.12); color: #d63031; }
      .foot-note { color: var(--muted); font-size: 13px; margin-top: 36px; text-align: center; }
      footer { text-align: center; color: var(--muted); font-size: 13px; padding: 32px 16px; border-top: 1px solid var(--border); margin-top: 24px; }
    </style>
  </body>
</html>
