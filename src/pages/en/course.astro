---
import SiteHeader from '../../components/SiteHeader.astro';
const base = import.meta.env.BASE_URL;

const course = {
  name: 'Fund Strategy · Four-Step DCA',
  en: '基金策略',
  desc: 'A practical DCA system across sector, active, bond and index funds.',
  chapters: [
    { slug: 'ch1-intro', title: 'Intro: why a system beats guessing', desc: 'Adopt "respond, do not predict".', free: true },
    { slug: 'ch2-four-step', title: 'Four-step DCA: sector / active / bond / index', desc: 'Roles and sizing of four fund types.', free: true },
    { slug: 'ch3-pick-fund', title: 'How to pick a fund: fees, tracking error, benchmark', desc: 'Low fees compound in your favor.', free: true },
    { slug: 'ch4-position', title: 'Sector-fund strategy for a choppy market', desc: 'In a sideways market, follow the trend and fade the wobble: scale in over 3 tranches, trim by deviation.', free: true },
    { slug: 'ch5-sector', title: 'Sector rotation: ride the up-cycle', desc: 'Entry, exit and taking profit on sector ETFs.', free: false },
    { slug: 'ch6-active', title: 'Active funds: manager, style, drawdown', desc: 'Spot managers who outperform long-term.', free: false },
    { slug: 'ch7-bond', title: 'Bond funds: duration & credit', desc: 'Use bonds to dampen portfolio volatility.', free: false },
    { slug: 'ch8-index', title: 'Active funds in a ranging market', desc: 'Buy drawdowns, not rallies; sell half at the 50% annualised line and swing a half position.', free: false },
    { slug: 'ch9-active-bear', title: 'Active funds in a bear market', desc: 'Staggered DCA only when time and space align; swing a half position to lower cost.', free: false },
    { slug: 'ch10-highdiv', title: 'High-Dividend Basics: SOEs / Banks / Utilities', desc: 'What yield is, why these three, buy when richer, sell when compressed, pair with DCA & grid.', free: true },
    { slug: 'ch11-etf-basics', title: 'ETF & Index Fund Basics', desc: 'Index fund vs ETF, four families, how to pick (fees / error / scale / liquidity).', free: false },
    { slug: 'ch12-grid-trading', title: 'ETF Grid Trading Basics', desc: 'Compound the small in choppy markets: band & rungs, stop below, clear above, complement DCA.', free: false },
    { slug: 'ch13-gold-macro', title: 'Gold & Fed Macro Basics', desc: 'Real rates price gold; how FOMC & dot plot move gold & equities; how to track macro.', free: false },
    { slug: 'ch14-bond-bull', title: 'Bond funds in a bull market', desc: 'Buy in one shot when below historical monthly average; scale out in thirds.', free: false, no: 14 },
    { slug: 'ch15-bond-shake', title: 'Bond funds in a ranging market', desc: 'Buy on drawdowns, widen the profit tolerance, keep ≥1/2 position.', free: false, no: 15 },
    { slug: 'ch16-cycle-why', title: 'Why we insist on cycle timing', desc: 'Institutions earn fees; we earn upside & dividends — and A-shares range.', free: false, no: 16 },
    { slug: 'ch17-index-fund', title: 'How to pick a quality index fund', desc: 'Two rules: listed 5+ years, repeatedly makes new highs.', free: false, no: 17 },
    { slug: 'ch18-index-shake', title: 'Index funds in a ranging market', desc: 'Buy pullbacks for swing gains; tiered entries by MA, exits by deviation.', free: false, no: 18 },
    { slug: 'ch19-index-bear', title: 'Index funds in a bear market', desc: 'Back to valuation: build below PE 30%, scale out as PE climbs.', free: false, no: 19 },
    { slug: 'ch20-index-bull', title: 'Index funds in a bull market', desc: 'Ride the trend and trail a stop: build on the 20-day breakout, add on pullbacks, scale out by drawdown.', free: false, no: 20 },
    { slug: 'ch20-undervalued', title: 'Undervalued Stock Screening Basics', desc: 'What "undervalued" means, PE/PB percentile & PEG, three screening conditions, value traps.', free: false, no: 21 },
    { slug: 'ch21-long-short', title: 'Long vs Short Basics', desc: 'Long buys then sells for a rise; short sells then buys for a fall; a 4-step account opening guide; A-share short tools and the ¥500k barrier.', free: false, no: 22 },
    { slug: 'ch22-leading-stocks', title: 'Leading-Stock Basics', desc: 'Why leaders are steadier, three leader types, emotion/chips/narrative triad, dragon-finding rules, pair with DCA & grid.', free: false, no: 23 },
    { slug: 'ch23-10w-finance', title: 'How to Invest ¥100k: the 5-3-2 Rule', desc: 'Protect the first pot: 50% anchor, 30% arbitrage, 20% DCA — with fixed-income landmines and a retail toolkit.', free: false, no: 24 },
    { slug: 'ch24-fund-types', title: 'Buy/sell playbook for 4 fund types: sector / active / bond / index', desc: 'Explains the differences and gives each a buy/sell discipline with concrete numbers.', free: true, no: 25 },
  ],
};
const freeCount = course.chapters.filter((c) => c.free).length;
const zsxqUrl = 'https://t.zsxq.com/PLACEHOLDER'; // TODO: replace with your Knowledge Planet share link
---

<SiteHeader lang="en" altLang="中文" altHref="/course" />
<main class="course">
  <p class="kicker">✦ Course · {course.chapters.length} chapters</p>
  <h1>{course.name}</h1>
  <p class="sub">{course.desc}</p>
  <p class="rule">First <b>{freeCount}</b> chapters free; the rest unlock with a <b>coffee tip ☕️</b> (min ¥1) — buy the author a coffee to unlock all content. Author is exempt.</p>

  <ol class="ch-list">
    {course.chapters.map((c, i) => (
      <li class={c.free ? 'free' : 'paid'}>
        <span class="no">{(c.no ?? (i + 1)).toString().padStart(2, '0')}</span>
        <a href={`${base}en/blog/${c.slug}`} class="title">{c.title}</a>
        {c.free ? <span class="tag free">Free</span> : <span class="tag paid">☕️ Buy me a coffee</span>}
        <p class="desc">{c.desc}</p>
      </li>
    ))}
  </ol>

  <section class="sel-cta">
    <h2>📈 Want it easier?</h2>
    <p>Use the <b>Stock Picker</b>: enter a ticker + your investable amount, and it reads the cycle, suggests how to invest, how much, and a DCA plan. Subscription only: $10/mo or $100/yr.</p>
    <a class="btn" href={`${base}en/selector`}>Open Stock Picker</a>
  </section>

  <section class="zsxq-cta">
    <h2>🪐 Want a more systematic companion?</h2>
    <p>Join the Knowledge Planet 「<b>股市笔记 · 基金定投实战圈 / Market Notes · DCA Circle</b>」: the full 23-chapter column as clean articles + weekly market notes + Q&amp;A + portfolio tracking + quarterly live streams. Blog readers who unlocked with code <b>gushi2026ch</b> get <b>50% off</b>.</p>
    <p class="price"><span>Early-bird <b>¥99/yr</b></span><span>Standard <b>¥199/yr</b> (~¥0.54/day)</span><span>Auto-renew ¥365/yr</span></p>
    <a class="btn" href={zsxqUrl} target="_blank" rel="noopener">🪐 Join the Planet</a>
  </section>

  <p class="foot-note">⚠️ For learning and entertainment only — not investment advice.</p>
</main>

<style is:global>
  .course { max-width: 760px; margin: 0 auto; padding: 48px 16px 40px; }
  .kicker { color: var(--accent); letter-spacing: 2px; font-size: 13px; margin: 0 0 8px; }
  .course h1 { font-size: 32px; margin: 0 0 10px; letter-spacing: 1px; }
  .sub { color: var(--muted); font-size: 16px; line-height: 1.8; margin: 0 0 8px; }
  .rule { background: var(--code-bg); border: 1px dashed var(--border); border-radius: 8px; padding: 10px 14px; font-size: 14px; color: var(--fg); }
  .rule b { color: var(--accent); }
  .ch-list { list-style: none; padding: 0; margin: 22px 0 0; }
  .ch-list li { padding: 16px; border: 1px solid var(--border); border-radius: 10px; margin-bottom: 12px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .ch-list li.paid { border-left: 4px solid #d63031; }
  .ch-list li.free { border-left: 4px solid var(--accent); }
  .no { color: var(--accent); font-weight: 800; font-size: 15px; }
  .title { font-weight: 600; color: var(--fg); text-decoration: none; font-size: 17px; }
  .tag { font-size: 12px; padding: 1px 9px; border-radius: 999px; font-weight: 600; }
  .tag.free { background: rgba(21,101,192,0.10); color: var(--accent); }
  .tag.paid { background: rgba(214,48,49,0.12); color: #d63031; }
  .desc { width: 100%; color: var(--muted); font-size: 13px; margin: 4px 0 0; }
  .sel-cta { margin-top: 30px; padding: 22px; border: 1px solid var(--border); border-radius: 12px; background: var(--code-bg); }
  .sel-cta h2 { margin: 0 0 8px; font-size: 20px; }
  .sel-cta p { color: var(--fg); font-size: 15px; line-height: 1.8; }
  .sel-cta b { color: var(--accent); }
  .btn { display: inline-block; margin-top: 12px; padding: 11px 24px; border-radius: 999px; background: var(--accent); color: #fff; text-decoration: none; font-size: 15px; }
  .btn:hover { opacity: .92; }
  .zsxq-cta { margin-top: 22px; padding: 22px; border: 1px solid #7c3aed; border-radius: 12px; background: rgba(124,58,237,0.07); }
  .zsxq-cta h2 { margin: 0 0 8px; font-size: 20px; }
  .zsxq-cta p { color: var(--fg); font-size: 15px; line-height: 1.8; }
  .zsxq-cta p b { color: #7c3aed; }
  .zsxq-cta .price { margin: 10px 0 0; display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 14px; color: var(--muted); }
  .zsxq-cta .price b { color: #7c3aed; }
  .zsxq-cta .btn { display: inline-block; margin-top: 14px; padding: 11px 24px; border-radius: 999px; background: #7c3aed; color: #fff; text-decoration: none; font-size: 15px; }
  .zsxq-cta .btn:hover { opacity: .92; }
  .foot-note { color: var(--muted); font-size: 13px; margin-top: 28px; text-align: center; }
</style>
